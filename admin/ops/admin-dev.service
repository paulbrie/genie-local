# Install as /etc/systemd/system/admin-dev.service.
# On-demand dev instance: hot-reload Next.js served at /admin-dev on :3002.
# No [Install] section — started/stopped from the UI (admin-ctl), not at boot.
[Unit]
Description=Projects Supervisor — admin-dev (Next.js DEV, /admin-dev on :3002)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=genie
Group=genie
WorkingDirectory=/opt/project/admin
# NODE_ENV unset → server.mjs runs Next in dev mode (HMR); the dev HMR upgrade
# is forwarded to Next, while /admin-dev/pty is handled by the PTY bridge.
Environment=PORT=3002
Environment=APP_BASE_PATH=/admin-dev
Environment=NEXT_PUBLIC_BASE_PATH=/admin-dev
Environment=APP_DIST_DIR=.next-dev
ExecStart=/usr/bin/node /opt/project/admin/server.mjs
# Don't kill project dev servers launched from the UI on stop/restart.
KillMode=process
Restart=on-failure
RestartSec=3
