# Install as /etc/systemd/system/admin.service (the PROD instance).
# Applied at the "prod flip": serves the built app at /admin on :3001 via
# `next start`. Until the flip, the live admin.service still runs `next dev`.
[Unit]
Description=Projects Supervisor — admin (Next.js PROD, /admin on :3001)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=genie
Group=genie
WorkingDirectory=/opt/project/admin
Environment=PORT=3001
Environment=APP_BASE_PATH=/admin
Environment=NEXT_PUBLIC_BASE_PATH=/admin
Environment=APP_DIST_DIR=.next-prod
ExecStart=/usr/bin/node /opt/project/admin/node_modules/next/dist/bin/next start -p 3001 -H 0.0.0.0
# KillMode=process so restarting admin (e.g. on deploy) does NOT kill the
# project dev servers launched from the UI (they live in this unit's cgroup).
KillMode=process
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
