{
  "display_information": {
    "name": "Genie",
    "description": "Terminals and tasks of the Genie server",
    "background_color": "#1f2933"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "genie",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/genie",
        "description": "Terminals and tasks of the Genie server",
        "usage_hint": "status | show <terminal> | send <terminal> <text> | ask <question> | tasks <project> | help",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "commands",
        "im:history",
        "im:write",
        "channels:history",
        "groups:history",
        "reactions:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["message.im", "message.channels", "message.groups"]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
