{
  "name": "admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node server.mjs",
    "build": "next build",
    "start": "NODE_ENV=production node server.mjs",
    "postinstall": "node -e \"const p=require('path'),fs=require('fs');try{const d=p.join(p.dirname(require.resolve('node-pty')),'..','prebuilds');if(fs.existsSync(d))for(const a of fs.readdirSync(d)){const h=p.join(d,a,'spawn-helper');if(fs.existsSync(h))fs.chmodSync(h,0o755)}}catch{}\"",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
